              "queryRef": "Zone.Zone",
              "nativeQueryRef": "Zone",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Key measures"
                    }
                  },
                  "Property": "Zone value"
                }
              },
              "queryRef": "Key measures.Zone value",
              "nativeQueryRef": "Zone value"
            }
          ]
        }
      },
      "sortDefinition": {
        "sort": [
          {
            "field": {
              "Measure": {
                "Expression": {
                  "SourceRef": {
                    "Entity": "Key measures"
                  }
                },
                "Property": "Zone value"
              }
            },
            "direction": "Descending"
          }
        ]
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'The six zones'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
